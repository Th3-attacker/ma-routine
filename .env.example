# Copie ce fichier en .env.local (jamais commité) et remplis les deux valeurs de ton projet Supabase
# (Project Settings → Data API / API Keys). La clé « anon / publishable » est faite pour être dans l'app :
# elle ne donne accès qu'aux données du compte connecté (règles RLS). Ne mets JAMAIS la clé service_role ici.
VITE_SUPABASE_URL=https://ton-projet.supabase.co
VITE_SUPABASE_ANON_KEY=ta-cle-publique
# Clé PUBLIQUE VAPID (notifications). La clé privée reste uniquement dans les secrets Supabase.
VITE_VAPID_PUBLIC_KEY=ta-cle-publique-vapid
